# Copy to `.env` and fill in real values before running ./bootstrap.sh.

# NGC API key (required for pulling the Riva container + models from NGC).
# Get one at https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# ---- Languages --------------------------------------------------------------
# Source language the user speaks into the mic (BCP-47). Baked in at bootstrap
# time because Riva's streaming ASR deploys one language-specific acoustic
# model. To change it, edit this value and re-run ./bootstrap.sh.
#
# Values supported by the default `conformer` acoustic model in Riva 2.19:
#   en-US, de-DE, es-US, es-ES, fr-FR, it-IT, ja-JP, ko-KR, pt-BR, ru-RU, zh-CN
SOURCE_LANGUAGE=zh-CN

# Target language for NMT + TTS (BCP-47). The Megatron 1B any-to-any NMT
# supports 36 languages, but TTS is constrained by what Magpie-Multilingual
# ships in the Riva 2.19 quickstart: en-US, es-US, fr-FR.
TARGET_LANGUAGE=en-US

# Magpie-Multilingual voice_name for the target language. The voice must
# already be deployed in the riva-model-repo volume; pick one whose language
# matches TARGET_LANGUAGE. Default below is EN-US; change it for ES-US/FR-FR.
TARGET_VOICE=Magpie-Multilingual.EN-US.Female.Neutral

# Riva ASR acoustic model. `conformer` covers the language list above. Other
# options (e.g. `parakeet-1.1b`) are English-only and higher quality.
ASR_ACOUSTIC_MODEL=conformer
