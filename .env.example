# Copy to `.env` and fill in real values before running ./bootstrap.sh.

# NGC API key (required for pulling the Riva container + models from NGC).
# Get one at https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# Optional. Public hostname or IP that browsers use to reach this VM, e.g.
# "gpu-abc123.brevlab.com" or "203.0.113.45". Used to set the subjectAltName
# on the self-signed TLS certificate so you don't see a name mismatch warning
# (you'll still get the "unknown CA" warning — that's expected with self-signed
# certs). Leave blank to accept any hostname.
PUBLIC_HOSTNAME=
